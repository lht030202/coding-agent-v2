# 模型服务：任意 OpenAI 兼容接口。下面以硅基流动为例。
CC_AGENT_LLM_PROVIDER=openai
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
OPENAI_TEMPERATURE=0.1

# 供应商扩展参数（JSON），通过 extra_body 传给接口。
# 硅基流动关闭 thinking：
OPENAI_EXTRA_BODY='{"enable_thinking": false}'
# DeepSeek 官方关闭 thinking 的写法：
# OPENAI_EXTRA_BODY='{"thinking": {"type": "disabled"}}'

# 模型调用的超时与重试（SDK 对 429、5xx 和连接错误做指数退避重试）
CC_AGENT_LLM_TIMEOUT=120
CC_AGENT_LLM_MAX_RETRIES=3

# 工具调用协议：native = 原生 function calling；json = 原版的 JSON 文本解析
CC_AGENT_TOOL_MODE=native
# 验证方式：tests = 调用 finish 时自动跑测试，失败就把输出交回模型；rule = 原版的规则判断
CC_AGENT_VERIFY_MODE=tests
CC_AGENT_MAX_STEPS=10
CC_AGENT_MAX_VERIFY_RETRIES=2

# 上下文管理：单个工具输出的上限（保留头尾）、整段对话的字符预算
CC_AGENT_TOOL_OUTPUT_CHARS=6000
CC_AGENT_CONTEXT_CHARS=60000

CC_AGENT_COMMAND_TIMEOUT=60
CC_AGENT_TRACE_DIR=traces
